<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    
    <!-- Version is set dynamically from version.txt or CI/CD -->
    <VersionFile>$(MSBuildProjectDirectory)\version.txt</VersionFile>
  </PropertyGroup>

  <!-- Read and increment version from file for local publish -->
  <Target Name="SetVersionFromFile" BeforeTargets="BeforeBuild;Publish">
    <PropertyGroup>
      <!-- Read current build number from file, default to 1 if not exists -->
      <BuildNumber Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</BuildNumber>
      <BuildNumber Condition="'$(BuildNumber)' == ''">1</BuildNumber>
      
      <!-- Set version if not provided via command line -->
      <Version Condition="'$(Version)' == '' OR '$(Version)' == '1.0.0'">1.0.$(BuildNumber)</Version>
      <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.$(BuildNumber).0</AssemblyVersion>
      <FileVersion Condition="'$(FileVersion)' == ''">1.0.$(BuildNumber).0</FileVersion>
    </PropertyGroup>
    <Message Importance="High" Text="Building with version: $(Version)" />
  </Target>

  <!-- Increment version file after successful publish -->
  <Target Name="IncrementVersionAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <CurrentBuildNumber Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</CurrentBuildNumber>
      <CurrentBuildNumber Condition="'$(CurrentBuildNumber)' == ''">1</CurrentBuildNumber>
      <NextBuildNumber>$([MSBuild]::Add($(CurrentBuildNumber), 1))</NextBuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionFile)" Lines="$(NextBuildNumber)" Overwrite="true" />
    <Message Importance="High" Text="Version incremented to: 1.0.$(NextBuildNumber) for next publish" />
  </Target>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.16" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.16" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyAccounts.Shared.Blazor\MyAccounts.Shared.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\favicon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\favicon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Don't include version.txt in published output -->
    <Content Update="version.txt">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Exclude version.txt from being included in the build -->
  <ItemGroup>
    <None Update="version.txt">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
