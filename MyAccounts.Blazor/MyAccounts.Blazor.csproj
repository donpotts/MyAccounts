<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    
    <!-- Auto-incrementing version based on date -->
    <!-- Format: Major.Minor.YYDDD.HHMM where DDD is day of year -->
    <VersionPrefix>1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    
    <!-- These will be set by the build target below -->
    <Version>$(VersionPrefix).0.0</Version>
    <AssemblyVersion>$(VersionPrefix).0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0.0</FileVersion>
  </PropertyGroup>

  <!-- Auto-generate version numbers based on build date/time -->
  <Target Name="SetBuildVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <!-- Year (last 2 digits) + Day of Year (001-366) -->
      <BuildNumber>$([System.DateTime]::UtcNow.ToString("yy"))$([System.DateTime]::UtcNow.DayOfYear.ToString("000"))</BuildNumber>
      <!-- Hour + Minute -->
      <RevisionNumber>$([System.DateTime]::UtcNow.ToString("HHmm"))</RevisionNumber>
      
      <Version>$(VersionPrefix).$(BuildNumber).$(RevisionNumber)</Version>
      <AssemblyVersion>$(VersionPrefix).$(BuildNumber).$(RevisionNumber)</AssemblyVersion>
      <FileVersion>$(VersionPrefix).$(BuildNumber).$(RevisionNumber)</FileVersion>
    </PropertyGroup>
    <Message Importance="High" Text="Building version: $(Version)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.16" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.16" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyAccounts.Shared.Blazor\MyAccounts.Shared.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\favicon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\favicon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
