<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>a6a59fd0-bbee-40c1-a13b-bea1a9b75eba</UserSecretsId>
		
		<!-- Version file location (in Blazor project) -->
		<BlazorVersionFile>$(MSBuildThisFileDirectory)..\MyAccounts.Blazor\version.txt</BlazorVersionFile>
	</PropertyGroup>

	<!-- Increment Blazor version file after successful publish of main project -->
	<Target Name="IncrementBlazorVersionAfterPublish" AfterTargets="Publish">
		<PropertyGroup>
			<CurrentBuildNumber Condition="Exists('$(BlazorVersionFile)')">$([System.IO.File]::ReadAllText('$(BlazorVersionFile)').Trim())</CurrentBuildNumber>
			<CurrentBuildNumber Condition="'$(CurrentBuildNumber)' == ''">1</CurrentBuildNumber>
			<NextBuildNumber>$([MSBuild]::Add($(CurrentBuildNumber), 1))</NextBuildNumber>
		</PropertyGroup>
		<WriteLinesToFile File="$(BlazorVersionFile)" Lines="$(NextBuildNumber)" Overwrite="true" />
		<Message Importance="High" Text="Blazor version incremented to: 1.0.$(NextBuildNumber) for next publish" />
	</Target>

	<ItemGroup>
		<None Remove="MyAccounts-2024-08-16-import.csv" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="MyAccounts-2024-08-16-import.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.17.1" />
		<PackageReference Include="Blazor-ApexCharts" Version="3.5.0" />
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.16" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.16" />
		<PackageReference Include="Microsoft.AspNetCore.OData" Version="9.4.1" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.16" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.16">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Graph" Version="5.99.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MyAccounts.Shared\MyAccounts.Shared.csproj" />
		<ProjectReference Include="..\MyAccounts.Blazor\MyAccounts.Blazor.csproj" />
	</ItemGroup>

</Project>