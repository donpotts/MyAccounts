<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>a6a59fd0-bbee-40c1-a13b-bea1a9b75eba</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="MyAccounts-2024-08-16-import.csv" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="MyAccounts-2024-08-16-import.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazor-ApexCharts" Version="3.5.0" />
		<PackageReference Include="ClosedXML" Version="0.105.0" />
