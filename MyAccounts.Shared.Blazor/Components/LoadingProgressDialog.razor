@using MudBlazor

<MudDialog>
    <TitleContent>
        <h3 class="mud-typography mud-h3">@Message</h3>
    </TitleContent>
    <DialogContent>
        <div>
            <p style="text-align: center;">Please wait...</p>
            <LoadingSpinner />
        </div>
    </DialogContent>
</MudDialog>

@code {
[CascadingParameter] MudDialogInstance MudDialog { get; set; }
[Parameter] public string Message { get; set; }
}
