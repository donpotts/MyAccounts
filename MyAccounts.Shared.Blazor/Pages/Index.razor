@page "/"
@inject AppService AppService
@inject ISnackbar Snackbar
@inject ThemeService ThemeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="mb-3">
    <MudText Typo="Typo.h3">Roxane's Accounting</MudText>
</div>

<AuthorizeView Roles="Administrator">
    <Authorized>
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h5">Dashboard</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" SelectedValue="@selectedRange" SelectedValueChanged="OnRangeChanged">
                        <MudChip Value="@("week")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Week</MudChip>
                        <MudChip Value="@("month")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Month</MudChip>
                        <MudChip Value="@("quarter")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Quarter</MudChip>
                        <MudChip Value="@("year")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Year</MudChip>
                    </MudChipSet>
                </MudStack>
            </MudStack>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="activeTabIndex" Color="MudBlazor.Color.Default" SliderColor="MudBlazor.Color.Primary">
                <MudTabPanel Text="Expenses by Category" Icon="@Icons.Material.Filled.PieChart">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (expenseData != null && expenseData.Count > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel()</MudText>
                                <MudText Typo="Typo.h6" Color="MudBlazor.Color.Error">Total Expenses: @totalExpenses.ToString("C")</MudText>
                            </div>
                        </MudStack>
                        <ApexChart TItem="ChartDataItem"
                                   Title=""
                                   Width="600"
                                   Height="400"
                                   @ref="expenseChart"
                                   Options="expenseChartOptions">
                            <ApexPointSeries TItem="ChartDataItem"
                                             Items="expenseData"
                                             Name="Expenses"
                                             SeriesType="SeriesType.Pie"
                                             XValue="e => e.Label"
                                             YValue="e => e.Value"
                                             ShowDataLabels />
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No expense data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Income vs Expenses" Icon="@Icons.Material.Filled.BarChart">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (incomeExpenseData != null && incomeExpenseData.Count > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-4">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel()</MudText>
                                <MudStack Row="true" Spacing="4">
                                    <MudText Typo="Typo.h6" Color="MudBlazor.Color.Success">Income: @totalIncome.ToString("C")</MudText>
                                    <MudText Typo="Typo.h6" Color="MudBlazor.Color.Error">Expenses: @totalExpenses.ToString("C")</MudText>
                                    <MudText Typo="Typo.h6" Color="@(netAmount >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)">Net: @netAmount.ToString("C")</MudText>
                                </MudStack>
                            </div>
                        </MudStack>
                        <ApexChart TItem="ChartDataItem"
                                   Title=""
                                   Width="700"
                                   Height="400"
                                   @ref="incomeExpenseChart"
                                   Options="incomeExpenseChartOptions">
                            <ApexPointSeries TItem="ChartDataItem"
                                             Items="incomeExpenseData"
                                             Name="Amount"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Label"
                                             YValue="e => e.Value"
                                             ShowDataLabels />
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Monthly Trend" Icon="@Icons.Material.Filled.TrendingUp">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (trendData != null && trendData.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel()</MudText>
                        <ApexChart TItem="TrendDataItem"
                                   Title=""
                                   Width="800"
                                   Height="400"
                                   @ref="trendChart"
                                   Options="trendChartOptions">
                            <ApexPointSeries TItem="TrendDataItem"
                                             Items="incomeTrendData"
                                             Name="Income"
                                             SeriesType="SeriesType.Line"
                                             XValue="e => e.Period"
                                             YValue="e => e.Value" />
                            <ApexPointSeries TItem="TrendDataItem"
                                             Items="expenseTrendData"
                                             Name="Expenses"
                                             SeriesType="SeriesType.Line"
                                             XValue="e => e.Period"
                                             YValue="e => e.Value" />
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No trend data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="By Account" Icon="@Icons.Material.Filled.AccountBalance">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (accountData != null && accountData.Count > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-4">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel()</MudText>
                                <MudText Typo="Typo.body2">Credits (Income) vs Debits (Expenses) by Account</MudText>
                            </div>
                        </MudStack>
                        <ApexChart TItem="AccountChartDataItem"
                                   Title=""
                                   Width="800"
                                   Height="400"
                                   @ref="accountChart"
                                   Options="accountChartOptions">
                            <ApexPointSeries TItem="AccountChartDataItem"
                                             Items="accountData"
                                             Name="Credits"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Account"
                                             YValue="e => e.Credits" />
                            <ApexPointSeries TItem="AccountChartDataItem"
                                             Items="accountData"
                                             Name="Debits"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Account"
                                             YValue="e => e.Debits" />
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No account data available for this period.</MudAlert>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudText>Simple Accounts application to manage your accounts.</MudText>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string selectedRange = "month";
    private int activeTabIndex = 0;
    private bool isLoading = false;
    private bool isAuthenticated = false;

    private List<ChartDataItem> expenseData = new();
    private List<ChartDataItem> incomeExpenseData = new();
    private List<TrendDataItem> trendData = new();
    private List<TrendDataItem> incomeTrendData = new();
    private List<TrendDataItem> expenseTrendData = new();
    private List<AccountChartDataItem> accountData = new();

    private ApexChart<ChartDataItem>? expenseChart;
    private ApexChart<ChartDataItem>? incomeExpenseChart;
    private ApexChart<TrendDataItem>? trendChart;
    private ApexChart<AccountChartDataItem>? accountChart;

    private ApexChartOptions<ChartDataItem> expenseChartOptions = new();
    private ApexChartOptions<ChartDataItem> incomeExpenseChartOptions = new();
    private ApexChartOptions<TrendDataItem> trendChartOptions = new();
    private ApexChartOptions<AccountChartDataItem> accountChartOptions = new();

    private decimal totalExpenses = 0;
    private decimal totalIncome = 0;
    private decimal netAmount = 0;

    private DateOnly startDate;
    private DateOnly endDate;

    public class ChartDataItem
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    public class TrendDataItem
    {
        public string Period { get; set; } = "";
        public string Type { get; set; } = "";
        public decimal Value { get; set; }
    }

    public class AccountChartDataItem
    {
        public string Account { get; set; } = "";
        public decimal Credits { get; set; }
        public decimal Debits { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated before loading data
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true && user.IsInRole("Administrator");
        
        if (!isAuthenticated)
        {
            // User is not authenticated or not an admin - don't load data
            return;
        }
        
        ThemeService.OnChange += OnThemeChanged;
        SetDateRange();
        ConfigureChartOptions();
        await LoadDataAsync();
    }

    private void ConfigureChartOptions()
    {
        var isDarkMode = ThemeService.IsDarkMode;
        var mode = isDarkMode ? Mode.Dark : Mode.Light;
        var background = isDarkMode ? "var(--mud-palette-background-dark)" : "var(--mud-palette-background)";
        var foreground = isDarkMode ? "#ffffff" : "#373d3f";

        expenseChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                // Safari fix: ensure proper event handling
                Animations = new Animations { Enabled = true },
                // Safari fix: set explicit selection mode
                Selection = new Selection { Enabled = true },
                // Safari fix: ensure proper zoom/pan handling
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FillSeriesColor = false,
                // Safari fix: use followCursor for better touch/hover detection
                FollowCursor = true,
                // Safari fix: set fixed position for more reliable display
                Fixed = new TooltipFixed { Enabled = false }
            },
            DataLabels = new DataLabels
            {
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                DropShadow = new DropShadow
                {
                    Enabled = true,
                    Top = 1,
                    Left = 1,
                    Blur = 2,
                    Opacity = 0.8
                },
                Formatter = @"function(value, { seriesIndex, w }) {
                    return '$' + w.config.series[seriesIndex].toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }"
            },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            }
        };

        incomeExpenseChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Intersect = false,
                Shared = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            Colors = new List<string> { "#66BB6A", "#EF5350" },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = false,
                    ColumnWidth = "50%",
                    Distributed = true
                }
            },
            Legend = new Legend { Show = false },
            DataLabels = new DataLabels
            {
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = foreground }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = foreground }
                    }
                }
            }
        };

        trendChartOptions = new ApexChartOptions<TrendDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Intersect = false,
                Shared = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            Colors = new List<string> { "#66BB6A", "#EF5350" },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            Markers = new Markers
            {
                Size = 5,
                Hover = new MarkersHover { SizeOffset = 3 }
            },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = foreground }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = foreground },
                        Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
                    }
                }
            }
        };

        accountChartOptions = new ApexChartOptions<AccountChartDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Intersect = false,
                Shared = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            Colors = new List<string> { "#66BB6A", "#EF5350" },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = false,
                    ColumnWidth = "70%"
                }
            },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            },
            DataLabels = new DataLabels
            {
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = foreground }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = foreground },
                        Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
                    }
                }
            }
        };
    }

    private async void OnThemeChanged()
    {
        ConfigureChartOptions();
        if (expenseChart != null) await expenseChart.UpdateOptionsAsync(true, true, true);
        if (incomeExpenseChart != null) await incomeExpenseChart.UpdateOptionsAsync(true, true, true);
        if (trendChart != null) await trendChart.UpdateOptionsAsync(true, true, true);
        if (accountChart != null) await accountChart.UpdateOptionsAsync(true, true, true);
        StateHasChanged();
    }

    private void SetDateRange()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        endDate = today;

        startDate = selectedRange switch
        {
            "week" => today.AddDays(-7),
            "month" => today.AddMonths(-1),
            "quarter" => today.AddMonths(-3),
            "year" => today.AddYears(-1),
            _ => today.AddMonths(-1)
        };
    }

    private string GetDateRangeLabel()
    {
        return $"{startDate:MMM dd, yyyy} - {endDate:MMM dd, yyyy}";
    }

    private async Task OnRangeChanged(string newRange)
    {
        selectedRange = newRange;
        SetDateRange();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var filter = $"Date ge {startDate:yyyy-MM-dd} and Date le {endDate:yyyy-MM-dd}";
            var result = await AppService.ListTransactionODataAsync(null, null, "Date ASC", filter, true, "Account,Category");

            if (result?.Value != null)
            {
                var transactions = result.Value.ToList();

                // Fetch TransactionSplit records for split transactions using date range
                // (avoids OData URL length limits when there are many transaction IDs)
                List<TransactionSplit> transactionSplits = new();
                var splitFilter = $"Transaction/Date ge {startDate:yyyy-MM-dd} and Transaction/Date le {endDate:yyyy-MM-dd}";
                var splitResult = await AppService.ListTransactionSplitODataAsync(null, null, null, splitFilter, true, "Transaction,Category");
                transactionSplits = splitResult?.Value?.ToList() ?? new();

                // Calculate totals using both transactions and splits
                // For income: positive amounts excluding transfers, and for Split transactions use the splits
                var incomeFromNonSplit = transactions
                    .Where(t => t.Amount > 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["))
                    .Sum(t => t.Amount ?? 0);
                var incomeFromSplits = transactionSplits
                    .Where(s => s.Amount > 0 && !s.Category.Name.StartsWith("Transfer:["))
                    .Sum(s => s.Amount ?? 0);
                totalIncome = incomeFromNonSplit + incomeFromSplits;

                // For expenses: negative amounts excluding transfers, and for Split transactions use the splits
                var expensesFromNonSplit = Math.Abs(transactions
                    .Where(t => t.Amount < 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["))
                    .Sum(t => t.Amount ?? 0));
                var expensesFromSplits = Math.Abs(transactionSplits
                    .Where(s => s.Amount < 0 && !s.Category.Name.StartsWith("Transfer:["))
                    .Sum(s => s.Amount ?? 0));
                totalExpenses = expensesFromNonSplit + expensesFromSplits;

                netAmount = totalIncome - totalExpenses;

                // Expense by category (pie chart) - merge transactions and splits
                expenseData = GroupExpensesByCategory(transactions, transactionSplits);

                // Income vs Expenses (bar chart)
                incomeExpenseData = new List<ChartDataItem>
                {
                    new ChartDataItem { Label = "Income", Value = totalIncome },
                    new ChartDataItem { Label = "Expenses", Value = totalExpenses }
                };

                // Monthly trend (line chart)
                trendData = BuildTrendData(transactions, transactionSplits);
                incomeTrendData = trendData.Where(x => x.Type == "Income").ToList();
                expenseTrendData = trendData.Where(x => x.Type == "Expenses").ToList();

                // By Account (grouped bar chart) - exclude transfers
                accountData = transactions
                    .Where(t => !t.Category.Name.StartsWith("Transfer:["))
                    .GroupBy(t => t.Account?.Name ?? "Unknown")
                    .Select(g => new AccountChartDataItem
                    {
                        Account = g.Key,
                        Credits = g.Where(t => t.Amount > 0).Sum(t => t.Amount ?? 0),
                        Debits = Math.Abs(g.Where(t => t.Amount < 0).Sum(t => t.Amount ?? 0))
                    })
                    .Where(a => a.Credits > 0 || a.Debits > 0)
                    .OrderByDescending(a => a.Credits + a.Debits)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboard data: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private List<ChartDataItem> GroupExpensesByCategory(List<Transaction> transactions, List<TransactionSplit> transactionSplits)
    {
        // Group expenses from non-split transactions
        var filteredTransactions = transactions
            .Where(t => t.Amount < 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["));

        var groupedData = filteredTransactions
            .GroupBy(t => t.Category.Name)
            .Select(g => new ChartDataItem
            {
                Label = g.Key,
                Value = Math.Abs(g.Sum(t => t.Amount ?? 0))
            })
            .ToList();

        // Group expenses from split transactions
        var filteredSplits = transactionSplits
            .Where(s => s.Amount < 0 && !s.Category.Name.StartsWith("Transfer:["));

        var groupedSplits = filteredSplits
            .GroupBy(s => s.Category.Name)
            .Select(g => new ChartDataItem
            {
                Label = g.Key,
                Value = Math.Abs(g.Sum(s => s.Amount ?? 0))
            })
            .ToList();

        // Merge split data into grouped data
        foreach (var split in groupedSplits)
        {
            var existingCategory = groupedData.FirstOrDefault(g => g.Label == split.Label);
            if (existingCategory != null)
            {
                existingCategory.Value += split.Value;
            }
            else
            {
                groupedData.Add(split);
            }
        }

        return groupedData
            .OrderByDescending(x => x.Value)
            .Take(10)
            .ToList();
    }

    private List<TrendDataItem> BuildTrendData(List<Transaction> transactions, List<TransactionSplit> transactionSplits)
    {
        var result = new List<TrendDataItem>();

        // Build a lookup of transaction ID to date for splits
        var transactionDates = transactions.ToDictionary(t => t.Id ?? 0, t => t.Date);

        // Group non-split transactions by period
        var groupedTransactions = transactions
            .Where(t => t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["))
            .GroupBy(t => new { Year = t.Date?.Year ?? 0, Month = t.Date?.Month ?? 0 })
            .ToDictionary(
                g => g.Key,
                g => new
                {
                    Income = g.Where(t => t.Amount > 0).Sum(t => t.Amount ?? 0),
                    Expenses = Math.Abs(g.Where(t => t.Amount < 0).Sum(t => t.Amount ?? 0))
                }
            );

        // Group splits with enhanced error handling
        var groupedSplits = transactionSplits
            .Where(s => !s.Category.Name.StartsWith("Transfer:["))
            .Select(s => new
            {
                Split = s,
                Date = transactionDates.GetValueOrDefault(s.TransactionId ?? 0)
            })
            .Where(x => x.Date.HasValue)
            .GroupBy(x => new { Year = x.Date!.Value.Year, Month = x.Date!.Value.Month })
            .ToDictionary(
                g => g.Key,
                g => new
                {
                    Income = g.Where(x => x.Split.Amount > 0).Sum(x => x.Split.Amount ?? 0),
                    Expenses = Math.Abs(g.Where(x => x.Split.Amount < 0).Sum(x => x.Split.Amount ?? 0))
                }
            );

        // Merge all periods
        var allPeriods = groupedTransactions.Keys.Union(groupedSplits.Keys).OrderBy(k => k.Year).ThenBy(k => k.Month);

        foreach (var period in allPeriods)
        {
            var periodLabel = $"{period.Year}-{period.Month:D2}";
            var transactionData = groupedTransactions.GetValueOrDefault(period);
            var splitData = groupedSplits.GetValueOrDefault(period);

            var income = (transactionData?.Income ?? 0) + (splitData?.Income ?? 0);
            var expenses = (transactionData?.Expenses ?? 0) + (splitData?.Expenses ?? 0);

            result.Add(new TrendDataItem { Period = periodLabel, Type = "Income", Value = income });
            result.Add(new TrendDataItem { Period = periodLabel, Type = "Expenses", Value = expenses });
        }

        return result;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= OnThemeChanged;
    }
}
