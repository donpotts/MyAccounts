@page "/"
@inject AppService AppService
@inject ISnackbar Snackbar
@inject ThemeService ThemeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="mb-3">
    <MudText Typo="Typo.h3">Roxane's Accounting</MudText>
</div>

<AuthorizeView Roles="Administrator">
    <Authorized>
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h5">Dashboard</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" SelectedValue="@selectedRange" SelectedValueChanged="OnRangeChanged">
                        <MudChip Value="@("week")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Week</MudChip>
                        <MudChip Value="@("month")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Month</MudChip>
                        <MudChip Value="@("quarter")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Quarter</MudChip>
                        <MudChip Value="@("year")" Variant="Variant.Text" Color="MudBlazor.Color.Default" SelectedColor="MudBlazor.Color.Primary">Year</MudChip>
                    </MudChipSet>
                </MudStack>
            </MudStack>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="activeTabIndex" Color="MudBlazor.Color.Default" SliderColor="MudBlazor.Color.Primary">
                <MudTabPanel Text="Expenses by Category" Icon="@Icons.Material.Filled.PieChart">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (expenseData != null && expenseData.Count > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel()</MudText>
                                <MudText Typo="Typo.h6" Color="MudBlazor.Color.Error">Total Expenses: @totalExpenses.ToString("C")</MudText>
                            </div>
                            <MudToggleGroup T="bool" @bind-Value="showDonutChart" Color="MudBlazor.Color.Primary" CheckMark Size="MudBlazor.Size.Small">
                                <MudToggleItem Value="false" Text="Pie" />
                                <MudToggleItem Value="true" Text="Donut" />
                            </MudToggleGroup>
                        </MudStack>
                        @if (showDonutChart)
                        {
                            <ApexChart TItem="ChartDataItem"
                                       Title=""
                                       Width="600"
                                       Height="400"
                                       @ref="donutChart"
                                       Options="donutChartOptions">
                                <ApexPointSeries TItem="ChartDataItem"
                                                 Items="expenseData"
                                                 Name="Expenses"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="e => e.Label"
                                                 YValue="e => e.Value"
                                                 ShowDataLabels />
                            </ApexChart>
                        }
                        else
                        {
                            <ApexChart TItem="ChartDataItem"
                                       Title=""
                                       Width="600"
                                       Height="400"
                                       @ref="expenseChart"
                                       Options="expenseChartOptions">
                                <ApexPointSeries TItem="ChartDataItem"
                                                 Items="expenseData"
                                                 Name="Expenses"
                                                 SeriesType="SeriesType.Pie"
                                                 XValue="e => e.Label"
                                                 YValue="e => e.Value"
                                                 ShowDataLabels />
                            </ApexChart>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No expense data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Income vs Expenses" Icon="@Icons.Material.Filled.BarChart">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (incomeExpenseData != null && incomeExpenseData.Count > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-4">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel()</MudText>
                                <MudStack Row="true" Spacing="4">
                                    <MudText Typo="Typo.h6" Color="MudBlazor.Color.Success">Income: @totalIncome.ToString("C")</MudText>
                                    <MudText Typo="Typo.h6" Color="MudBlazor.Color.Error">Expenses: @totalExpenses.ToString("C")</MudText>
                                    <MudText Typo="Typo.h6" Color="@(netAmount >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)">Net: @netAmount.ToString("C")</MudText>
                                </MudStack>
                            </div>
                        </MudStack>
                        <ApexChart TItem="ChartDataItem"
                                   Title=""
                                   Width="700"
                                   Height="400"
                                   @ref="incomeExpenseChart"
                                   Options="incomeExpenseChartOptions">
                            <ApexPointSeries TItem="ChartDataItem"
                                             Items="incomeExpenseData"
                                             Name="Amount"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Label"
                                             YValue="e => e.Value"
                                             ShowDataLabels />
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Monthly Trend" Icon="@Icons.Material.Filled.TrendingUp">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (trendData != null && trendData.Count > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-2">
                            <MudText Typo="Typo.subtitle1">@GetDateRangeLabel()</MudText>
                            <MudToggleGroup T="bool" @bind-Value="showStackedArea" Color="MudBlazor.Color.Primary" CheckMark Size="MudBlazor.Size.Small">
                                <MudToggleItem Value="false" Text="Line" />
                                <MudToggleItem Value="true" Text="Stacked Area" />
                            </MudToggleGroup>
                        </MudStack>
                        @if (showStackedArea && stackedAreaData.Count > 0)
                        {
                            <ApexChart TItem="StackedAreaDataItem"
                                       Title=""
                                       Width="800"
                                       Height="400"
                                       @ref="stackedAreaChart"
                                       Options="stackedAreaChartOptions">
                                @foreach (var category in stackedAreaData.Select(x => x.Category).Distinct())
                                {
                                    <ApexPointSeries TItem="StackedAreaDataItem"
                                                     Items="stackedAreaData.Where(x => x.Category == category).ToList()"
                                                     Name="@category"
                                                     SeriesType="SeriesType.Area"
                                                     XValue="e => e.Period"
                                                     YValue="e => e.Value" />
                                }
                            </ApexChart>
                        }
                        else
                        {
                            <ApexChart TItem="TrendDataItem"
                                       Title=""
                                       Width="800"
                                       Height="400"
                                       @ref="trendChart"
                                       Options="trendChartOptions">
                                <ApexPointSeries TItem="TrendDataItem"
                                                 Items="incomeTrendData"
                                                 Name="Income"
                                                 SeriesType="SeriesType.Line"
                                                 XValue="e => e.Period"
                                                 YValue="e => e.Value" />
                                <ApexPointSeries TItem="TrendDataItem"
                                                 Items="expenseTrendData"
                                                 Name="Expenses"
                                                 SeriesType="SeriesType.Line"
                                                 XValue="e => e.Period"
                                                 YValue="e => e.Value" />
                            </ApexChart>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No trend data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="By Account" Icon="@Icons.Material.Filled.AccountBalance">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (accountData != null && accountData.Count > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-4">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel()</MudText>
                                <MudText Typo="Typo.body2">Credits (Income) vs Debits (Expenses) by Account</MudText>
                            </div>
                        </MudStack>
                        <ApexChart TItem="AccountChartDataItem"
                                   Title=""
                                   Width="800"
                                   Height="400"
                                   @ref="accountChart"
                                   Options="accountChartOptions">
                            <ApexPointSeries TItem="AccountChartDataItem"
                                             Items="accountData"
                                             Name="Credits"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Account"
                                             YValue="e => e.Credits" />
                            <ApexPointSeries TItem="AccountChartDataItem"
                                             Items="accountData"
                                             Name="Debits"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Account"
                                             YValue="e => e.Debits" />
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No account data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Spending Heatmap" Icon="@Icons.Material.Filled.GridOn">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (heatmapData != null && heatmapData.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel() - Spending by Day of Week</MudText>
                        <ApexChart TItem="HeatmapDataItem"
                                   Title=""
                                   Width="800"
                                   Height="350"
                                   @ref="heatmapChart"
                                   Options="heatmapChartOptions">
                            @foreach (var day in heatmapData.Select(x => x.YLabel).Distinct())
                            {
                                <ApexPointSeries TItem="HeatmapDataItem"
                                                 Items="heatmapData.Where(x => x.YLabel == day).ToList()"
                                                 Name="@day"
                                                 SeriesType="SeriesType.Heatmap"
                                                 XValue="e => e.XLabel"
                                                 YValue="e => e.Value" />
                            }
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No heatmap data available for this period.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Category Breakdown" Icon="@Icons.Material.Filled.ViewModule">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else if (treemapData != null && treemapData.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-2">@GetDateRangeLabel() - Expense Categories</MudText>
                        <ApexChart TItem="TreemapDataItem"
                                   Title=""
                                   Width="800"
                                   Height="400"
                                   @ref="treemapChart"
                                   Options="treemapChartOptions">
                            <ApexPointSeries TItem="TreemapDataItem"
                                             Items="treemapData"
                                             Name="Expenses"
                                             SeriesType="SeriesType.Treemap"
                                             XValue="e => e.Category"
                                             YValue="e => e.Value" />
                        </ApexChart>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="my-4">No category data available for this period.</MudAlert>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudText>Simple Accounts application to manage your accounts.</MudText>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string selectedRange = "month";
    private int activeTabIndex = 0;
    private bool isLoading = false;
    private bool isAuthenticated = false;

    private List<ChartDataItem> expenseData = new();
    private List<ChartDataItem> incomeExpenseData = new();
    private List<TrendDataItem> trendData = new();
    private List<TrendDataItem> incomeTrendData = new();
    private List<TrendDataItem> expenseTrendData = new();
    private List<AccountChartDataItem> accountData = new();

    private ApexChart<ChartDataItem>? expenseChart;
    private ApexChart<ChartDataItem>? incomeExpenseChart;
    private ApexChart<TrendDataItem>? trendChart;
    private ApexChart<AccountChartDataItem>? accountChart;
    private ApexChart<ChartDataItem>? donutChart;
    private ApexChart<StackedAreaDataItem>? stackedAreaChart;
    private ApexChart<TreemapDataItem>? treemapChart;
    private ApexChart<HeatmapDataItem>? heatmapChart;

    private ApexChartOptions<ChartDataItem> expenseChartOptions = new();
    private ApexChartOptions<ChartDataItem> incomeExpenseChartOptions = new();
    private ApexChartOptions<TrendDataItem> trendChartOptions = new();
    private ApexChartOptions<AccountChartDataItem> accountChartOptions = new();
    private ApexChartOptions<ChartDataItem> donutChartOptions = new();
    private ApexChartOptions<StackedAreaDataItem> stackedAreaChartOptions = new();
    private ApexChartOptions<TreemapDataItem> treemapChartOptions = new();
    private ApexChartOptions<HeatmapDataItem> heatmapChartOptions = new();

    // Toggle states for chart type switching
    private bool showDonutChart = false;
    private bool showStackedArea = false;

    // New chart data lists
    private List<StackedAreaDataItem> stackedAreaData = new();
    private List<TreemapDataItem> treemapData = new();
    private List<HeatmapDataItem> heatmapData = new();

    private decimal totalExpenses = 0;
    private decimal totalIncome = 0;
    private decimal netAmount = 0;

    private DateOnly startDate;
    private DateOnly endDate;


    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated before loading data
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true && user.IsInRole("Administrator");
        
        if (!isAuthenticated)
        {
            // User is not authenticated or not an admin - don't load data
            return;
        }
        
        ThemeService.OnChange += OnThemeChanged;
        SetDateRange();
        ConfigureChartOptions();
        await LoadDataAsync();
    }

    private void ConfigureChartOptions()
    {
        var isDarkMode = ThemeService.IsDarkMode;
        var mode = isDarkMode ? Mode.Dark : Mode.Light;
        var background = isDarkMode ? "var(--mud-palette-background-dark)" : "var(--mud-palette-background)";
        var foreground = isDarkMode ? "#ffffff" : "#373d3f";

        expenseChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                // Safari fix: ensure proper event handling
                Animations = new Animations { Enabled = true },
                // Safari fix: set explicit selection mode
                Selection = new Selection { Enabled = true },
                // Safari fix: ensure proper zoom/pan handling
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FillSeriesColor = false,
                // Safari fix: use followCursor for better touch/hover detection
                FollowCursor = true,
                // Safari fix: set fixed position for more reliable display
                Fixed = new TooltipFixed { Enabled = false }
            },
            DataLabels = new DataLabels
            {
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                DropShadow = new DropShadow
                {
                    Enabled = true,
                    Top = 1,
                    Left = 1,
                    Blur = 2,
                    Opacity = 0.8
                },
                Formatter = @"function(value, { seriesIndex, w }) {
                    return '$' + w.config.series[seriesIndex].toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }"
            },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            }
        };

        incomeExpenseChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Intersect = false,
                Shared = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            Colors = new List<string> { "#66BB6A", "#EF5350" },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = false,
                    ColumnWidth = "50%",
                    Distributed = true
                }
            },
            Legend = new Legend { Show = false },
            DataLabels = new DataLabels
            {
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = foreground }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = foreground }
                    }
                }
            }
        };

        trendChartOptions = new ApexChartOptions<TrendDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Intersect = false,
                Shared = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            Colors = new List<string> { "#66BB6A", "#EF5350" },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            Markers = new Markers
            {
                Size = 5,
                Hover = new MarkersHover { SizeOffset = 3 }
            },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = foreground }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = foreground },
                        Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
                    }
                }
            }
        };

        accountChartOptions = new ApexChartOptions<AccountChartDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Intersect = false,
                Shared = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            Colors = new List<string> { "#66BB6A", "#EF5350" },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = false,
                    ColumnWidth = "70%"
                }
            },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            },
            DataLabels = new DataLabels
            {
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = foreground }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = foreground },
                        Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
                    }
                }
            }
        };

        // Donut chart options (similar to pie but with center label)
        donutChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FillSeriesColor = false,
                FollowCursor = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    Donut = new PlotOptionsDonut
                    {
                        Size = "65%",
                        Labels = new DonutLabels
                        {
                            Show = true,
                            Total = new DonutLabelTotal
                            {
                                Show = true,
                                Label = "Total",
                                FontSize = "16px",
                                Color = foreground,
                                Formatter = @"function(w) {
                                    return '$' + w.globals.seriesTotals.reduce((a, b) => a + b, 0)
                                        .toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                }"
                            }
                        }
                    }
                }
            },
            DataLabels = new DataLabels
            {
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                DropShadow = new DropShadow
                {
                    Enabled = true,
                    Top = 1,
                    Left = 1,
                    Blur = 2,
                    Opacity = 0.8
                },
                Formatter = @"function(value, { seriesIndex, w }) {
                    return '$' + w.config.series[seriesIndex].toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }"
            },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            }
        };

        // Stacked Area chart options
        stackedAreaChartOptions = new ApexChartOptions<StackedAreaDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Stacked = true,
                StackType = StackType.Normal,
                Animations = new Animations { Enabled = true },
                Selection = new Selection { Enabled = true },
                Zoom = new Zoom { Enabled = false }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Intersect = false,
                Shared = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            Colors = new List<string> { "#66BB6A", "#EF5350", "#42A5F5", "#FFA726", "#AB47BC", "#26C6DA", "#D4E157", "#78909C" },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Fill = new Fill { Type = FillType.Gradient },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            },
            Xaxis = new XAxis
            {
                Type = XAxisType.Category,
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = foreground }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = foreground },
                        Formatter = @"function(value) { return '$' + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
                    }
                }
            }
        };

        // Treemap chart options
        treemapChartOptions = new ApexChartOptions<TreemapDataItem>
        {
            Theme = new Theme { Mode = mode },
            Chart = new Chart
            {
                Background = background,
                Animations = new Animations { Enabled = true }
            },
            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            DataLabels = new DataLabels
            {
                Enabled = true,
                Style = new DataLabelsStyle
                {
                    FontSize = "14px"
                },
                Formatter = @"function(text, op) {
                    return [text, '$' + op.value.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 })];
                }"
            },
            PlotOptions = new PlotOptions
            {
                Treemap = new PlotOptionsTreemap
                {
                    EnableShades = true,
                    ShadeIntensity = 0.5,
                    Distributed = true
                }
            },
            Colors = new List<string> { "#42A5F5", "#66BB6A", "#FFA726", "#AB47BC", "#26C6DA", "#EF5350", "#D4E157", "#78909C" },
            Legend = new Legend
            {
                Labels = new LegendLabels { Colors = foreground }
            }
        };

