    private async void OnThemeChanged()
    {
        ConfigureChartOptions();
        if (expenseChart != null) await expenseChart.UpdateOptionsAsync(true, true, true);
        if (incomeExpenseChart != null) await incomeExpenseChart.UpdateOptionsAsync(true, true, true);
        if (trendChart != null) await trendChart.UpdateOptionsAsync(true, true, true);
        if (accountChart != null) await accountChart.UpdateOptionsAsync(true, true, true);
        if (donutChart != null) await donutChart.UpdateOptionsAsync(true, true, true);
        if (stackedAreaChart != null) await stackedAreaChart.UpdateOptionsAsync(true, true, true);
        if (treemapChart != null) await treemapChart.UpdateOptionsAsync(true, true, true);
        if (heatmapChart != null) await heatmapChart.UpdateOptionsAsync(true, true, true);
        StateHasChanged();
    }

    private void SetDateRange()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        endDate = today;

        startDate = selectedRange switch
        {
            "week" => today.AddDays(-7),
            "month" => today.AddMonths(-1),
            "quarter" => today.AddMonths(-3),
            "year" => today.AddYears(-1),
            _ => today.AddMonths(-1)
        };
    }

    private string GetDateRangeLabel()
    {
        return $"{startDate:MMM dd, yyyy} - {endDate:MMM dd, yyyy}";
    }

    private async Task OnRangeChanged(string newRange)
    {
        selectedRange = newRange;
        SetDateRange();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var filter = $"Date ge {startDate:yyyy-MM-dd} and Date le {endDate:yyyy-MM-dd}";
            var result = await AppService.ListTransactionODataAsync(null, null, "Date ASC", filter, true, "Account,Category");

            if (result?.Value != null)
            {
                var transactions = result.Value.ToList();

                // Fetch TransactionSplit records for split transactions using date range
                // (avoids OData URL length limits when there are many transaction IDs)
                List<TransactionSplit> transactionSplits = new();
                var splitFilter = $"Transaction/Date ge {startDate:yyyy-MM-dd} and Transaction/Date le {endDate:yyyy-MM-dd}";
                var splitResult = await AppService.ListTransactionSplitODataAsync(null, null, null, splitFilter, true, "Transaction,Category");
                transactionSplits = splitResult?.Value?.ToList() ?? new();

                // Calculate totals using both transactions and splits
                // For income: positive amounts excluding transfers, and for Split transactions use the splits
                var incomeFromNonSplit = transactions
                    .Where(t => t.Amount > 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["))
                    .Sum(t => t.Amount ?? 0);
                var incomeFromSplits = transactionSplits
                    .Where(s => s.Amount > 0 && !s.Category.Name.StartsWith("Transfer:["))
                    .Sum(s => s.Amount ?? 0);
                totalIncome = incomeFromNonSplit + incomeFromSplits;

                // For expenses: negative amounts excluding transfers, and for Split transactions use the splits
                var expensesFromNonSplit = Math.Abs(transactions
                    .Where(t => t.Amount < 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["))
                    .Sum(t => t.Amount ?? 0));
                var expensesFromSplits = Math.Abs(transactionSplits
                    .Where(s => s.Amount < 0 && !s.Category.Name.StartsWith("Transfer:["))
                    .Sum(s => s.Amount ?? 0));
                totalExpenses = expensesFromNonSplit + expensesFromSplits;

                netAmount = totalIncome - totalExpenses;

                // Expense by category (pie chart) - merge transactions and splits
                expenseData = GroupExpensesByCategory(transactions, transactionSplits);

                // Income vs Expenses (bar chart)
                incomeExpenseData = new List<ChartDataItem>
                {
                    new ChartDataItem { Label = "Income", Value = totalIncome },
                    new ChartDataItem { Label = "Expenses", Value = totalExpenses }
                };

                // Monthly trend (line chart)
                trendData = BuildTrendData(transactions, transactionSplits);
                incomeTrendData = trendData.Where(x => x.Type == "Income").ToList();
                expenseTrendData = trendData.Where(x => x.Type == "Expenses").ToList();

                // By Account (grouped bar chart) - exclude transfers
                accountData = transactions
                    .Where(t => !t.Category.Name.StartsWith("Transfer:["))
                    .GroupBy(t => t.Account?.Name ?? "Unknown")
                    .Select(g => new AccountChartDataItem
                    {
                        Account = g.Key,
                        Credits = g.Where(t => t.Amount > 0).Sum(t => t.Amount ?? 0),
                        Debits = Math.Abs(g.Where(t => t.Amount < 0).Sum(t => t.Amount ?? 0))
                    })
                    .Where(a => a.Credits > 0 || a.Debits > 0)
                    .OrderByDescending(a => a.Credits + a.Debits)
                    .ToList();

                // Build data for new chart types
                stackedAreaData = BuildStackedAreaData(transactions, transactionSplits);
                treemapData = BuildTreemapData(transactions, transactionSplits);
                heatmapData = BuildHeatmapData(transactions, transactionSplits);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboard data: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private List<ChartDataItem> GroupExpensesByCategory(List<Transaction> transactions, List<TransactionSplit> transactionSplits)
    {
        // Group expenses from non-split transactions
        var filteredTransactions = transactions
            .Where(t => t.Amount < 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["));

        var groupedData = filteredTransactions
            .GroupBy(t => t.Category.Name)
            .Select(g => new ChartDataItem
            {
                Label = g.Key,
                Value = Math.Abs(g.Sum(t => t.Amount ?? 0))
            })
            .ToList();

        // Group expenses from split transactions
        var filteredSplits = transactionSplits
            .Where(s => s.Amount < 0 && !s.Category.Name.StartsWith("Transfer:["));

        var groupedSplits = filteredSplits
            .GroupBy(s => s.Category.Name)
            .Select(g => new ChartDataItem
            {
                Label = g.Key,
                Value = Math.Abs(g.Sum(s => s.Amount ?? 0))
            })
            .ToList();

        // Merge split data into grouped data
        foreach (var split in groupedSplits)
        {
            var existingCategory = groupedData.FirstOrDefault(g => g.Label == split.Label);
            if (existingCategory != null)
            {
                existingCategory.Value += split.Value;
            }
            else
            {
                groupedData.Add(split);
            }
        }

        return groupedData
            .OrderByDescending(x => x.Value)
            .Take(10)
            .ToList();
    }

    private List<TrendDataItem> BuildTrendData(List<Transaction> transactions, List<TransactionSplit> transactionSplits)
    {
        var result = new List<TrendDataItem>();

        // Build a lookup of transaction ID to date for splits
        var transactionDates = transactions.ToDictionary(t => t.Id ?? 0, t => t.Date);

        // Group non-split transactions by period
        var groupedTransactions = transactions
            .Where(t => t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:["))
            .GroupBy(t => new { Year = t.Date?.Year ?? 0, Month = t.Date?.Month ?? 0 })
            .ToDictionary(
                g => g.Key,
                g => new
                {
                    Income = g.Where(t => t.Amount > 0).Sum(t => t.Amount ?? 0),
                    Expenses = Math.Abs(g.Where(t => t.Amount < 0).Sum(t => t.Amount ?? 0))
                }
            );

        // Group splits with enhanced error handling
        var groupedSplits = transactionSplits
            .Where(s => !s.Category.Name.StartsWith("Transfer:["))
            .Select(s => new
            {
                Split = s,
                Date = transactionDates.GetValueOrDefault(s.TransactionId ?? 0)
            })
            .Where(x => x.Date.HasValue)
            .GroupBy(x => new { Year = x.Date!.Value.Year, Month = x.Date!.Value.Month })
            .ToDictionary(
                g => g.Key,
                g => new
                {
                    Income = g.Where(x => x.Split.Amount > 0).Sum(x => x.Split.Amount ?? 0),
                    Expenses = Math.Abs(g.Where(x => x.Split.Amount < 0).Sum(x => x.Split.Amount ?? 0))
                }
            );

        // Merge all periods
        var allPeriods = groupedTransactions.Keys.Union(groupedSplits.Keys).OrderBy(k => k.Year).ThenBy(k => k.Month);

        foreach (var period in allPeriods)
        {
            var periodLabel = $"{period.Year}-{period.Month:D2}";
            var transactionData = groupedTransactions.GetValueOrDefault(period);
            var splitData = groupedSplits.GetValueOrDefault(period);

            var income = (transactionData?.Income ?? 0) + (splitData?.Income ?? 0);
            var expenses = (transactionData?.Expenses ?? 0) + (splitData?.Expenses ?? 0);

            result.Add(new TrendDataItem { Period = periodLabel, Type = "Income", Value = income });
            result.Add(new TrendDataItem { Period = periodLabel, Type = "Expenses", Value = expenses });
        }

        return result;
    }

    private List<StackedAreaDataItem> BuildStackedAreaData(List<Transaction> transactions, List<TransactionSplit> transactionSplits)
    {
        var result = new List<StackedAreaDataItem>();
        var transactionDates = transactions.ToDictionary(t => t.Id ?? 0, t => t.Date);

        // Get top 5 expense categories
        var topCategories = GroupExpensesByCategory(transactions, transactionSplits)
            .Take(5)
            .Select(x => x.Label)
            .ToList();

        // Group non-split transactions by period and category
        var groupedTransactions = transactions
            .Where(t => t.Amount < 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:[") && topCategories.Contains(t.Category.Name))
            .GroupBy(t => new { Year = t.Date?.Year ?? 0, Month = t.Date?.Month ?? 0, Category = t.Category.Name })
            .ToDictionary(
                g => g.Key,
                g => Math.Abs(g.Sum(t => t.Amount ?? 0))
            );

        // Group splits by period and category
        var groupedSplits = transactionSplits
            .Where(s => s.Amount < 0 && !s.Category.Name.StartsWith("Transfer:[") && topCategories.Contains(s.Category.Name))
            .Select(s => new { Split = s, Date = transactionDates.GetValueOrDefault(s.TransactionId ?? 0) })
            .Where(x => x.Date.HasValue)
            .GroupBy(x => new { Year = x.Date!.Value.Year, Month = x.Date!.Value.Month, Category = x.Split.Category.Name })
            .ToDictionary(
                g => g.Key,
                g => Math.Abs(g.Sum(x => x.Split.Amount ?? 0))
            );

        // Get all unique periods
        var allPeriods = groupedTransactions.Keys.Select(k => new { k.Year, k.Month })
            .Union(groupedSplits.Keys.Select(k => new { k.Year, k.Month }))
            .Distinct()
            .OrderBy(k => k.Year).ThenBy(k => k.Month)
            .ToList();

        // Build result for each period and category
        foreach (var period in allPeriods)
        {
            var periodLabel = $"{period.Year}-{period.Month:D2}";
            foreach (var category in topCategories)
            {
                var transKey = new { period.Year, period.Month, Category = category };
                var splitKey = new { period.Year, period.Month, Category = category };
                var transValue = groupedTransactions.GetValueOrDefault(transKey, 0);
                var splitValue = groupedSplits.GetValueOrDefault(splitKey, 0);
                result.Add(new StackedAreaDataItem { Period = periodLabel, Category = category, Value = transValue + splitValue });
            }
        }

        return result;
    }

    private List<TreemapDataItem> BuildTreemapData(List<Transaction> transactions, List<TransactionSplit> transactionSplits)
    {
        // Use the same expense data as the pie chart
        var expensesByCategory = GroupExpensesByCategory(transactions, transactionSplits);

        return expensesByCategory.Select(x => new TreemapDataItem
        {
            Category = x.Label,
            ParentCategory = null,
            Value = x.Value
        }).ToList();
    }

    private List<HeatmapDataItem> BuildHeatmapData(List<Transaction> transactions, List<TransactionSplit> transactionSplits)
    {
        var result = new List<HeatmapDataItem>();
        var transactionDates = transactions.ToDictionary(t => t.Id ?? 0, t => t.Date);

        // Get expense transactions with dates
        var expenseTransactions = transactions
            .Where(t => t.Amount < 0 && t.Category.Name != "Split" && !t.Category.Name.StartsWith("Transfer:[") && t.Date.HasValue)
            .Select(t => new { Date = t.Date!.Value, Amount = Math.Abs(t.Amount ?? 0) })
            .ToList();

        // Add split transactions
        var expenseSplits = transactionSplits
            .Where(s => s.Amount < 0 && !s.Category.Name.StartsWith("Transfer:["))
            .Select(s => new { Date = transactionDates.GetValueOrDefault(s.TransactionId ?? 0), Amount = Math.Abs(s.Amount ?? 0) })
            .Where(x => x.Date.HasValue)
            .Select(x => new { Date = x.Date!.Value, x.Amount })
            .ToList();

        var allExpenses = expenseTransactions.Concat(expenseSplits).ToList();

        // Group by day of week and week number
        var grouped = allExpenses
            .GroupBy(x => new { DayOfWeek = x.Date.DayOfWeek, WeekOfYear = GetIso8601WeekOfYear(x.Date) })
            .Select(g => new HeatmapDataItem
            {
                YLabel = g.Key.DayOfWeek.ToString(),
                XLabel = $"Wk {g.Key.WeekOfYear}",
                Value = g.Sum(x => x.Amount)
            })
            .ToList();

        // Ensure we have all days of week for each week that has data
        var weeks = grouped.Select(x => x.XLabel).Distinct().OrderBy(x => x).ToList();
        var days = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };

        foreach (var week in weeks)
        {
            foreach (var day in days)
            {
                var existing = grouped.FirstOrDefault(g => g.XLabel == week && g.YLabel == day);
                if (existing == null)
                {
                    result.Add(new HeatmapDataItem { YLabel = day, XLabel = week, Value = 0 });
                }
                else
                {
                    result.Add(existing);
                }
            }
        }

        return result;
    }

    private static int GetIso8601WeekOfYear(DateOnly date)
    {
        var dayOfWeek = (int)date.DayOfWeek;
        var dayOfYear = date.DayOfYear;
        return (dayOfYear - dayOfWeek + 10) / 7;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= OnThemeChanged;
    }
