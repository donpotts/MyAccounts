            Tooltip = new Tooltip
            {
                Enabled = true,
                FollowCursor = true,
                Fixed = new TooltipFixed { Enabled = false }
            },
            DataLabels = new DataLabels
            {
                Enabled = true,
                Style = new DataLabelsStyle
                {
                    Colors = new List<string> { "#ffffff" }
                },
                Formatter = @"function(value) { return '$' + value.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }"
            },
            PlotOptions = new PlotOptions
            {
