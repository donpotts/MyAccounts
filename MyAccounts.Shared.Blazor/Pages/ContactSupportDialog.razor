@inject ISnackbar Snackbar
@inject AppService AppService
@inject AuthenticationStateProvider AuthStateProvider
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Contact Support</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">Fill out the form below and we'll get back to you as soon as possible.</MudText>
        <MudTextField @bind-Value="Name" Label="Your Name" Variant="Variant.Outlined" Required="true" Immediate="true" Class="mb-2" />
        <MudTextField @bind-Value="Message" Label="Message" Variant="Variant.Outlined" Required="true" Immediate="true" Lines="4" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@IsSending">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="@SendAsync" Disabled="@(!CanSend || IsSending)">
            @if (IsSending)
            {
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Sending...</span>
            }
            else
            {
                <span>Send</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    private string Name { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;
    private bool IsSending { get; set; } = false;
    private bool CanSend => !string.IsNullOrWhiteSpace(Name) && !string.IsNullOrWhiteSpace(Message);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            Email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? user.FindFirst("email")?.Value
                ?? string.Empty;
        }
    }

    private async Task SendAsync()
    {
        if (!CanSend || IsSending) return;
        IsSending = true;
        StateHasChanged();
        try
        {
            var success = await AppService.SendSupportMessageAsync(Name, Email, Message);
            if (success)
            {
                Snackbar.Add("Your message was sent! We'll get back to you soon.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("There was a problem sending your message. Please try again later.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("There was a problem sending your message. Please try again later.", Severity.Error);
        }
        finally
        {
            IsSending = false;
            StateHasChanged();
        }
    }
    private void Cancel() => MudDialog.Cancel();
}
