@page "/backup"
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using MyAccounts.Shared.Models
@inject AppService AppService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>Database Backup</PageTitle>

<div class="mb-3">
    <MudText Typo="Typo.h3">Database Backup</MudText>
    <MudText Typo="Typo.body1">Download or schedule database backups in JSON format.</MudText>
</div>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">Manual Backup</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="DownloadBackupAsync"
                           Disabled="_isDownloading"
                           StartIcon="@Icons.Material.Filled.CloudDownload">
                    @if (_isDownloading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2" Typo="Typo.button">Downloading...</MudText>
                    }
                    else
                    {
                        <MudText Class="ms-2" Typo="Typo.button">Download Backup</MudText>
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="TriggerServerBackupAsync"
                           Disabled="_isServerBackup"
                           StartIcon="@Icons.Material.Filled.Save">
                    @if (_isServerBackup)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2" Typo="Typo.button">Saving...</MudText>
                    }
                    else
                    {
                        <MudText Class="ms-2" Typo="Typo.button">Save to Server</MudText>
                    }
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Backup Information</MudText>
            <MudList T="string" Dense="true">
                <MudListItem Icon="@Icons.Material.Filled.Schedule">
                    Auto-backup: Daily at 2:00 AM
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Storage">
                    Format: JSON (Entity Framework export)
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.DataObject">
                    Includes: Accounts, Transactions, Categories, Budgets
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Loop">
                    Server keeps 7 rolling backups (one per day of week)
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Cloud">
                    Works with Azure PostgreSQL and all hosting platforms
                </MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-4" Elevation="1">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h6">Backup History</MudText>
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   OnClick="LoadLogsAsync"
                   StartIcon="@Icons.Material.Filled.Refresh">
            Refresh
        </MudButton>
    </MudStack>

    @if (_isLoadingLogs)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_logs == null || !_logs.Any())
    {
        <MudAlert Severity="Severity.Info">No backup logs found.</MudAlert>
    }
    else
    {
        <MudTable Items="_logs" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>Date/Time</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>File Name</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date/Time">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small" Color="@(context.BackupType == "Scheduled" ? Color.Info : Color.Default)">
                        @context.BackupType
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="File Name">@context.FileName</MudTd>
                <MudTd DataLabel="Size">@FormatFileSize(context.FileSizeBytes)</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Success)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    }
                    else
                    {
                        <MudTooltip Text="@context.ErrorMessage">
                            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isDownloading;
    private bool _isServerBackup;
    private bool _isLoadingLogs;
    private string? _errorMessage;
    private BackupLog[]? _logs;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        _isLoadingLogs = true;
        StateHasChanged();

        try
        {
            _logs = await AppService.GetBackupLogsAsync(50);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load logs: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingLogs = false;
            StateHasChanged();
        }
    }

    private async Task DownloadBackupAsync()
    {
        _isDownloading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await AppService.DownloadBackupAsync();
            if (result != null)
            {
                var base64 = Convert.ToBase64String(result.Value.Data);
                await JSRuntime.InvokeVoidAsync("downloadFileFromStream", result.Value.FileName, base64);
                Snackbar.Add("Backup downloaded successfully", Severity.Success);
                await LoadLogsAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to download backup: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isDownloading = false;
            StateHasChanged();
        }
    }

    private async Task TriggerServerBackupAsync()
    {
        _isServerBackup = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            await AppService.TriggerServerBackupAsync();
            Snackbar.Add("Server backup created successfully", Severity.Success);
            await LoadLogsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create server backup: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isServerBackup = false;
            StateHasChanged();
        }
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }
}
