@page "/transactioncsvimport"
@inject ISnackbar Snackbar
@inject AppService AppService
@inject IDialogService DialogService
@inject HttpClient HttpClient
@inject NavigationService NavigationService
@attribute [Authorize(Roles = "Administrator")]
@using CsvHelper.Configuration
@using Size = MudBlazor.Size

<PageTitle>Credit Card Transaction Import</PageTitle>

<div class="mb-3">
    <MudText Typo="Typo.h3">Credit Card Transaction Import</MudText>
    <MudText Typo="Typo.body1">Import credit card transactions from a CSV file.</MudText>
</div>

<MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged" Accept=".csv">
    <ActivatorContent>
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
            Upload CSV
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    private RegisterModel registerModel = new();

    private async Task OnFileChanged(IBrowserFile file)
    {
        // Open dialog to select account
        var dialogOptions = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = DialogService.Show<AccountSelectorDialog>("Select Account", dialogOptions);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not long accountId)
        {
            Snackbar.Add("No transaction account selected.", Severity.Warning);
            return;
        }
        Console.WriteLine($"Selected AccountId: {accountId}");
        await UploadCsvAsync(file, accountId);
        NavigationService.NotifyStateChanged();
        StateHasChanged();
    }

    private async Task<string?> UploadCsvAsync(IBrowserFile file, long accountId)
    {
        if (file.ContentType != "text/csv")
        {
            Snackbar.Add("Only CSV files can be uploaded.", Severity.Error);
            return null;
        }

        try
        {
            Console.WriteLine($"Uploading CSV for AccountId: {accountId}");
            var response = await AppService.UploadCsvAsync(file, accountId);
            if (!string.IsNullOrWhiteSpace(response))
            {
                var jsonDoc = System.Text.Json.JsonDocument.Parse(response);
                if (jsonDoc.RootElement.TryGetProperty("insertedCount", out var insertedCountElem))
                {
                    int insertedCount = insertedCountElem.GetInt32();
                    Snackbar.Add($"Imported {insertedCount} transactions.", Severity.Success);
                }
            }
            MudDialog?.Close();
            NavigationService.NotifyStateChanged();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        return null;
    }
}
