@page "/bankimport"
@using CsvHelper.Configuration
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@inject ISnackbar Snackbar
@inject AppService AppService
@inject IDialogService DialogService
@inject ILogger<BankImport> Logger
@inject NavigationService NavigationService
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>Statement Import</PageTitle>

<div class="mb-3">
    <MudText Typo="Typo.h3">Statement Import</MudText>
    <MudText Typo="Typo.body1">Import bank transactions from a CSV bank statement file and match them with existing transactions.</MudText>
</div>

<div>
    <MudFileUpload T="IBrowserFile" Accept=".csv" FilesChanged="ProcessFileAsync" Disabled="_isProcessing || _isSaving">
        <ActivatorContent>
            <MudButton Variant="Variant.Filled" Color="Color.Primary">
                @if (_isProcessing)
                {
                    <MudProgressCircular class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2" Typo="Typo.button">Processing</MudText>
                }
                else
                {
                    <MudIcon Class="ms-n1" Size="Size.Small" Icon="@Icons.Material.Filled.UploadFile" />
                    <MudText Class="ms-2" Typo="Typo.button">Import Bank CSV</MudText>
                }
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>
</div>

@if (_bankRecords.Count > 0)
{
    <div class="mt-10">
        <MudText Typo="Typo.h4" Class="mb-2">Bank Records</MudText>
        <MudDataGrid Items="_bankRecords" Hover="true" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="x => x.Date" />
                <PropertyColumn Property="x => x.Time" />
                <PropertyColumn Property="x => x.Amount" Format="C" />
                <PropertyColumn Property="x => x.Type" />
                <PropertyColumn Property="x => x.Description" />
                <PropertyColumn Property="x => x.Category" />
            </Columns>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </div>

    <div class="mt-10">
        <MudText Typo="Typo.h4" Class="mb-2">Transactions</MudText>
        <MudSelect T="long?" Label="Account" Value="_selectedAccount" ValueChanged="@(async value => await AccountChangedAsync(value))" Class="mb-2" Disabled="_isSaving">
            @foreach (var account in _accounts ?? Enumerable.Empty<Account>())
            {
                <MudSelectItem Value="account.Id">@account.Name</MudSelectItem>
            }
        </MudSelect>

        <MudDataGrid T="Transaction" @ref="_transactionsDataGrid" ServerData="LoadServerDataAsync" Hover SortMode="SortMode.None" EditMode="DataGridEditMode.Cell" ReadOnly="false">
            <Columns>
                <PropertyColumn Property="x => x.Cleared">
                    <EditTemplate>
                        <MudCheckBox T="bool" Value="context.Item.Cleared" ValueChanged="@(value => ClearedTransactionsChanged(value, context.Item))" Disabled="_isSaving" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Id" Editable="false" />
                <PropertyColumn Property="x => x.Date" Editable="false" />
                <PropertyColumn Property="x => x.Amount" Format="C" Editable="false" />
                <PropertyColumn Property="x => x.Payee" Editable="false" />
                <PropertyColumn Property="x => x.Description" Editable="false" />
                <PropertyColumn Property="x => x.Category!.Name" Title="Category" Editable="false" />
            </Columns>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="SaveChangesAsync" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2" Typo="Typo.button">Saving Changes</MudText>
            }
            else
            {
                <MudIcon Class="ms-n1" Size="Size.Small" Icon="@Icons.Material.Filled.Save" />
                <MudText Class="ms-2" Typo="Typo.button">Save Changes</MudText>
            }
        </MudButton>

        <MudText Typo="Typo.h6">Total Uncleared Amount: @string.Format("{0:C}", _unclearedSum)</MudText>

    </div>
}

@code {
    private class BankRecord
    {
        public DateOnly Date { get; set; }
        public TimeOnly Time { get; set; }
        public decimal Amount { get; set; }
        public string? Type { get; set; }
        public string? Description { get; set; }
        public string? Category { get; set; }
    }

    private class ABankStatement
    {
        [CsvHelper.Configuration.Attributes.Name("date")]
        [CsvHelper.Configuration.Attributes.Format("yyyy-MM-dd", "MM/dd/yyyy", "M/d/yyyy", "yyyy/MM/dd")]
        public DateOnly Date { get; set; }
        [CsvHelper.Configuration.Attributes.Name("time")]
        [CsvHelper.Configuration.Attributes.Optional]
        [CsvHelper.Configuration.Attributes.Format("HH:mm:ss", "HH:mm", "h:mm:ss tt", "h:mm tt")]
        public TimeOnly Time { get; set; }
        [CsvHelper.Configuration.Attributes.Name("amount")]
        public decimal Amount { get; set; }
        [CsvHelper.Configuration.Attributes.Name("type")]
        [CsvHelper.Configuration.Attributes.Optional]
        public string? Type { get; set; }
        [CsvHelper.Configuration.Attributes.Name("description")]
        [CsvHelper.Configuration.Attributes.Optional]
        public string? Description { get; set; }
        [CsvHelper.Configuration.Attributes.Name("category")]
        [CsvHelper.Configuration.Attributes.Optional]
        public string? Category { get; set; }
    }

    private class UBankStatement
    {
        public DateOnly Date { get; set; }
        public string? Description { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Original Description")]
        public string? OriginalDescription { get; set; }
        public string? Category { get; set; }
        public decimal Amount { get; set; }
        public string? Status { get; set; }
    }

    private class NBankStatement
    {
        [CsvHelper.Configuration.Attributes.Name("Posting Date")]
        public DateOnly PostingDate { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Transaction Date")]
        public DateOnly TransactionDate { get; set; }
        public decimal Amount { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Credit Debit Indicator")]
        public string? CreditDebitIndicator { get; set; }
        [CsvHelper.Configuration.Attributes.Name("type")]
        public string? Type { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Type Group")]
        public string? TypeGroup { get; set; }
        public string? Reference { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Instructed Currency")]
        public string? InstructedCurrency { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Currency Exchange Rate")]
        public decimal? CurrencyExchangeRate { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Instructed Amount")]
        public decimal? InstructedAmount { get; set; }
        public string? Description { get; set; }
        public string? Category { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Check Serial Number")]
        public string? CheckSerialNumber { get; set; }
        [CsvHelper.Configuration.Attributes.Name("Card Ending")]
        public string? CardEnding { get; set; }
    }

    private Account[]? _accounts;
    private Category[]? _categories;
    private bool _isProcessing = false;
    private bool _isSaving = false;
    private List<BankRecord> _bankRecords = [];
    private long? _selectedAccount;
    private HashSet<Transaction> _selectedTransactions = [];
    private MudDataGrid<Transaction>? _transactionsDataGrid;
    private decimal? _unclearedSum = 0;
    private bool _isCancelled = false;

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        _accounts = await AppService.ListAccountAsync();
        _categories = await AppService.ListCategoryAsync();
    }

    private async Task ShowTransactionDialog(BankRecord bankRecord)
    {
        _isCancelled = false;
        var parameters = new DialogParameters
        {
            { "Message", $"<strong>Add transaction?</strong><br>{bankRecord.Amount} on {bankRecord.Date}" },
            { "Details", $"<strong>Amount:</strong> {bankRecord.Amount}<br><strong>Date:</strong> {bankRecord.Date}<br><strong>Description:</strong><br>{bankRecord.Description}" },
            { "AddTransaction", new Func<Task>(async () => await AddTransaction(bankRecord)) },
            { "NextTransaction", new Func<Task>(async () => await NextTransaction(bankRecord)) },
            { "Cancel", new Action(Cancel) }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            BackdropClick = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            Position = DialogPosition.Center
        };
        var dialog = DialogService.Show<AddBankTransaction>("Missing Transaction", parameters, options);
        var dr = await dialog.Result;

        if (!dr.Canceled)
        {
            _isCancelled = false;
        }
    }

    private async Task AddTransaction(BankRecord bankRecord)
    {
        long? categoryId = 1; // Default category
        
        // Look up or create category from CSV if provided
        if (!string.IsNullOrWhiteSpace(bankRecord.Category))
        {
            var existingCategory = _categories?.FirstOrDefault(c => 
                c.Name != null && c.Name.Equals(bankRecord.Category, StringComparison.OrdinalIgnoreCase));
            
            if (existingCategory != null)
            {
                categoryId = existingCategory.Id;
            }
            else
            {
                // Create new category and get the returned category with ID
                var newCategory = new Category { Name = bankRecord.Category };
                var createdCategory = await AppService.InsertCategoryAsync(newCategory);
                if (createdCategory?.Id != null)
                {
                    categoryId = createdCategory.Id;
                }
                // Reload categories to include the new one
                _categories = await AppService.ListCategoryAsync();
            }
        }

        var newTransaction = new Transaction
        {
            Date = bankRecord.Date,
            Amount = bankRecord.Amount,
            Description = "From Bank CSV Import!",
            AccountId = _selectedAccount.Value,
            Cleared = true,
            Payee = bankRecord.Description,
            CategoryId = categoryId,
        };

        await AppService.InsertTransactionAsync(newTransaction);
        NavigationService.NotifyStateChanged();
    }

    private async Task NextTransaction(BankRecord bankRecord)
    {
        StateHasChanged();
    }

    private void Cancel()
    {
        _isCancelled = true;
    }

    private void ClearState()
    {
        _bankRecords.Clear();
        _selectedAccount = null;
        _selectedTransactions.Clear();
        StateHasChanged();
    }

    private async Task ProcessFileAsync(IBrowserFile? file)
    {
        if (file == null)
        {
            return;
        }

        _isProcessing = true;
        StateHasChanged();

        try
        {
            if (file.ContentType != "text/csv")
            {
                Snackbar.Add("The imported file is not a CSV.", Severity.Error);
                return;
            }

            ClearState();

            using (var fs = file.OpenReadStream())
            using (StreamReader reader = new(fs))
            {
                // Read the header line to determine format
                var headerLine = await reader.ReadLineAsync();
                if (string.IsNullOrEmpty(headerLine))
                {
                    Snackbar.Add("The imported file is empty.", Severity.Warning);
                    return;
                }

                // Create a new stream with the full content (header + remaining lines)
                var remainingContent = await reader.ReadToEndAsync();
                var fullContent = headerLine + Environment.NewLine + remainingContent;
                using var memoryStream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(fullContent));
                using var newReader = new StreamReader(memoryStream);

                var config = new CsvConfiguration(CultureInfo.InvariantCulture) 
                { 
                    TrimOptions = TrimOptions.Trim,
                    HeaderValidated = null, // Don't throw on header validation
                    MissingFieldFound = null, // Don't throw on missing optional fields
                    PrepareHeaderForMatch = args => args.Header.Trim().ToLowerInvariant(), // Normalize headers for matching
                    // Auto-detect delimiter (tab or comma)
                    Delimiter = headerLine.Contains('\t') ? "\t" : ","
                };

                // Check if header matches one of the alternate formats
                var headers = headerLine.Split(new[] { '\t', ',' }, StringSplitOptions.TrimEntries);
                var isNFormat = headers.Contains("Posting Date") || headers.Contains("Credit Debit Indicator");
                var isUFormat = headers.Contains("Original Description") || headers.Contains("Status");

                if (isNFormat)
                {
                    using CsvReader csv = new(newReader, config);
                    try
                    {
                        await foreach (var record in csv.GetRecordsAsync<NBankStatement>())
                        {
                            var amount = record.CreditDebitIndicator == "Debit" ? -Math.Abs(record.Amount) : Math.Abs(record.Amount);
                            _bankRecords.Add(new BankRecord
                            {
                                Date = record.TransactionDate,
                                Amount = amount,
                                Description = record.Description,
                                Type = record.Type ?? record.TypeGroup,
                                Time = default,
                                Category = record.Category
                            });
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Error processing NFCU format: {Message}", ex.Message);
                        throw; // Re-throw to be caught by outer exception handler
                    }
                }
                else if (isUFormat)
                {
                    using CsvReader csv = new(newReader, config);
                    try
                    {
                        await foreach (var record in csv.GetRecordsAsync<UBankStatement>())
                        {
                            _bankRecords.Add(new BankRecord
                            {
                                Date = record.Date,
                                Amount = record.Amount,
                                Description = record.Description,
                                Type = record.Category,
                                Time = default,
                                Category = record.Category
                            });
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Error processing USAA format: {Message}", ex.Message);
                        throw; // Re-throw to be caught by outer exception handler
                    }
                }
                else
                {
                    using CsvReader csv = new(newReader, config);
                    try
                    {
                        await foreach (var record in csv.GetRecordsAsync<ABankStatement>())
                        {
                            _bankRecords.Add(new BankRecord
                            {
                                Date = record.Date,
                                Amount = record.Amount,
                                Description = record.Description,
                                Type = record.Type,
                                Time = record.Time,
                                Category = record.Category
                            });
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Error processing standard bank statement format: {Message}", ex.Message);
                        throw; // Re-throw to be caught by outer exception handler
                    }
                }
            }

            if (_bankRecords.Count == 0)
            {
                Snackbar.Add("The imported file contains no records.", Severity.Warning);
                return;
            }

            _bankRecords = _bankRecords.OrderByDescending(r => r.Date).ThenByDescending(r => r.Time).ToList();
        }
        catch(CsvHelperException ex)
        {
            _bankRecords.Clear();
            Logger.LogError(ex, "CSV parsing error: {Message}", ex.Message);
            
            // Provide user-friendly error message based on the exception
            var friendlyMessage = "There was an error processing the CSV file. ";
            
            // Try to extract specific error details
            var innerMessage = ex.InnerException?.Message ?? ex.Message;
            var context = ex.Context;
            
            if (context?.Reader != null)
            {
                var row = context.Reader.CurrentIndex + 1;
                var rawRecord = context.Reader.Parser?.RawRecord?.Trim();
                friendlyMessage += $"Error on row {row}. ";
                
                if (!string.IsNullOrEmpty(rawRecord) && rawRecord.Length <= 100)
                {
                    friendlyMessage += $"Data: \"{rawRecord}\". ";
                }
            }
            
            if (innerMessage.Contains("header", StringComparison.OrdinalIgnoreCase))
            {
                friendlyMessage += "The file headers don't match the expected format. Please check the CSV file structure.";
            }
            else if (innerMessage.Contains("convert", StringComparison.OrdinalIgnoreCase) || 
                     innerMessage.Contains("parse", StringComparison.OrdinalIgnoreCase) ||
                     innerMessage.Contains("TypeConverterException", StringComparison.OrdinalIgnoreCase))
            {
                // Try to identify which field caused the issue
                if (innerMessage.Contains("Date", StringComparison.OrdinalIgnoreCase))
                {
                    friendlyMessage += "Invalid date format detected. Expected format: MM/DD/YYYY or YYYY-MM-DD.";
                }
                else if (innerMessage.Contains("Amount", StringComparison.OrdinalIgnoreCase) || 
                         innerMessage.Contains("decimal", StringComparison.OrdinalIgnoreCase))
                {
                    friendlyMessage += "Invalid amount format detected. Amounts should be numeric values like 123.45.";
                }
                else if (innerMessage.Contains("Time", StringComparison.OrdinalIgnoreCase))
                {
                    friendlyMessage += "Invalid time format detected. Expected format: HH:MM:SS or HH:MM.";
                }
                else
                {
                    friendlyMessage += "Some data in the file couldn't be read. Please check that dates and amounts are formatted correctly.";
                }
            }
            else
            {
                friendlyMessage += "Please ensure the file is a valid bank statement CSV with the correct format.";
            }
            
            Snackbar.Add(friendlyMessage, Severity.Error);
        }
        catch (Exception ex)
        {
            _bankRecords.Clear();
            Logger.LogError(ex, "Unexpected error processing bank import: {Message}", ex.Message);
            
            var errorDetails = ex.Message.Length > 100 ? ex.Message.Substring(0, 100) + "..." : ex.Message;
            Snackbar.Add($"An unexpected error occurred: {errorDetails}. Please try again or contact support.", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task AccountChangedAsync(long? id)
    {
        _selectedAccount = id;
        _selectedTransactions.Clear();

        if (_transactionsDataGrid != null)
        {
            await _transactionsDataGrid.ReloadServerData();
        }
        StateHasChanged();
    }

    private async Task<GridData<Transaction>> LoadServerDataAsync(GridState<Transaction> state)
    {
        _selectedTransactions.Clear();

        if (!_selectedAccount.HasValue)
        {
            return new() { TotalItems = 0, Items = Enumerable.Empty<Transaction>() };
        }

        var top = 1000;
        var skip = state.Page * state.PageSize;
        var orderby = "Date DESC, Id DESC";
        var specificDate = _bankRecords.OrderByDescending(record => record.Date).Select(record => record.Date).FirstOrDefault().AddDays(5);
        var filter = $"AccountId eq {_selectedAccount} and Date lt {specificDate:yyyy-MM-dd}";

        var result = await AppService.ListTransactionODataAsync(top, skip, orderby, filter, false, "Category");

        _unclearedSum = result?.Value?.Where(transaction => !transaction.Cleared).Sum(transaction => transaction.Amount) ?? 0;

        var newTransactions = result?.Value ?? Enumerable.Empty<Transaction>();

        await CheckTransactionsAsync(newTransactions);

        return new() { TotalItems = result?.Count ?? 0, Items = result?.Value ?? Enumerable.Empty<Transaction>() };
    }

    private async Task CheckTransactionsAsync(IEnumerable<Transaction> transactions)
    {
        foreach (var bankRecord in _bankRecords)
        {
            if (_isCancelled)
            {
                break;
            }
            _isCancelled = false;

            var matchingTransaction = transactions?
                .FirstOrDefault(transaction => transaction.Date != null
                    && bankRecord.Date != null
                    && bankRecord.Date.Month == transaction.Date.Value.Month
                    && (transaction.Amount * -1) == (bankRecord.Amount * -1));

            if (matchingTransaction != null)
            {
                // Update category if existing transaction is uncategorized and bank record has a category
                if (!string.IsNullOrWhiteSpace(bankRecord.Category) &&
                    (matchingTransaction.Category == null ||
                     matchingTransaction.Category.Name == null ||
                     matchingTransaction.Category.Name.Equals("Uncategorized", StringComparison.OrdinalIgnoreCase)))
                {
                    // Look up or create the category
                    var existingCategory = _categories?.FirstOrDefault(c =>
                        c.Name != null && c.Name.Equals(bankRecord.Category, StringComparison.OrdinalIgnoreCase));

                    long? categoryId;
                    if (existingCategory != null)
                    {
                        categoryId = existingCategory.Id;
                    }
                    else
                    {
                        // Create new category and get the returned category with ID
                        var newCategory = new Category { Name = bankRecord.Category };
                        var createdCategory = await AppService.InsertCategoryAsync(newCategory);
                        if (createdCategory?.Id != null)
                        {
                            categoryId = createdCategory.Id;
                        }
                        else
                        {
                            categoryId = 1; // Fallback to default if creation failed
                        }
                        // Reload categories to include the new one
                        _categories = await AppService.ListCategoryAsync();
                    }

                    // Update the transaction's category
                    matchingTransaction.CategoryId = categoryId;
                    matchingTransaction.Category = _categories?.FirstOrDefault(c => c.Id == categoryId);
                    await AppService.UpdateTransactionAsync(matchingTransaction.Id!.Value, matchingTransaction);
                }
            }
            else if (!_isCancelled)
            {
                await ShowTransactionDialog(bankRecord);
            }
        }
    }

    private void ClearedTransactionsChanged(bool cleared, Transaction transaction)
    {
        transaction.Cleared = cleared;

        if (cleared)
        {
            _selectedTransactions.Add(transaction);
        }
        else
        {
            _selectedTransactions.Remove(transaction);
        }
    }

    private async Task SaveChangesAsync()
    {
        _isSaving = true;
        _isCancelled = true;
        StateHasChanged();

        try
        {
            if (_selectedTransactions.Count == 0)
            {
                Snackbar.Add("There are no changes to save.", Severity.Info);
                return;
            }

            foreach (var transaction in _selectedTransactions)
            {
                await AppService.UpdateTransactionAsync(transaction.Id!.Value, transaction);
            }

            Snackbar.Add("The changes have been saved.", Severity.Success);

            if (_transactionsDataGrid != null)
            {
                await _transactionsDataGrid.ReloadServerData();
            }
        }
        catch (Exception)
        {
            Snackbar.Add("There was an error while saving changes.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
}
