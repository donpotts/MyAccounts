@page "/banktransaction"
@inject IDialogService DialogService

<MudDialog Style="min-height: 250px;">
    <DialogContent>
        <div style="min-height: 150px;">
            <MudText Typo="Typo.h6" Class="mb-4">
                @((MarkupString)Message)
            </MudText>
            <MudText Typo="Typo.body1" Style="word-wrap: break-word; overflow-wrap: break-word;">
                @((MarkupString)Details)
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="AddTransactionAndClose" Color="MudBlazor.Color.Primary" Variant="Variant.Filled">Add</MudButton>
        <MudButton OnClick="NextTransactionAndClose" Color="MudBlazor.Color.Secondary" Variant="Variant.Filled">Next</MudButton>
        <MudButton OnClick="CancelDialog" Color="MudBlazor.Color.Error" Variant="Variant.Filled">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public string Message { get; set; }
    [Parameter] public string Details { get; set; }
    [Parameter] public Func<Task> AddTransaction { get; set; }
    [Parameter] public Func<Task> NextTransaction { get; set; }
    [Parameter] public Action Cancel { get; set; }

    private async Task AddTransactionAndClose()
    {
        await AddTransaction.Invoke();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task NextTransactionAndClose()
    {
        await NextTransaction.Invoke();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void CancelDialog()
    {
        Cancel.Invoke();
        MudDialog.Cancel();
    }
}